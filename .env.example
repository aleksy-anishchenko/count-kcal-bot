# Скопируй в .env и заполни. Node читает его сам: `node --env-file=.env ...`

# Токен бота от @BotFather в Telegram
BOT_TOKEN=123456789:AAAbbbCCCdddEEEfffGGGhhh

# Ключ API DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Таймзона, по которой считаются «дни» в дневнике (IANA-название)
TZ=Europe/Moscow

# Файл базы SQLite (создастся сам)
DB_PATH=./kcal.db

# Необязательно: кому разрешено пользоваться ботом (Telegram user id через запятую).
# Пусто — пускаем всех. Свой id бот покажет в ответе, если доступ закрыт.
ALLOWED_USER_IDS=
