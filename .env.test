# Окружение для `npm test`. Секретов нет — файл можно хранить в репозитории.
# Тесты не ходят ни в Telegram, ни в DeepSeek, поэтому токены — заглушки.
BOT_TOKEN=test-token
DEEPSEEK_API_KEY=test-key
TZ=Europe/Moscow
# База в памяти: каждый файл тестов запускается отдельным процессом и получает свою пустую базу.
DB_PATH=:memory:
# Пользователь 1 — свой, остальные — чужие: на этом строятся тесты доступа (bot/create-bot.test.ts).
ALLOWED_USER_IDS=1
